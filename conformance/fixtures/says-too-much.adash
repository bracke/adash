--  Read by a conformance case. Writes more than a shell will hold in one
--  capture, so that the refusal can be asserted on every host rather than only
--  where a program like `yes` happens to exist.
--
--  Sixteen thousand lines of a hundred characters is a little over a mebibyte,
--  which is the smallest `read.limit` a user can set -- so a case that sets the
--  limit to one and captures this gets the refusal without waiting for a
--  program that never stops.
Wide : String := "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";

for Line in 1 .. 16_000 loop
   put_line (Wide);
end loop;

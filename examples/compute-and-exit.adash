--  Compute a value, then exit with it.
--
--  This is the most basic shell script there is, and until commands became
--  calls in the language it could not be written: a submission was either
--  internal commands or program statements, never both, and a command's
--  arguments were the source text they were written with rather than values.
--  `quit (Total)` passed the five characters "Total".
--
--  Both are gone. `quit` is a procedure the analyser knows, its status is an
--  Integer it type-checks, and the value arrives from the virtual machine at
--  the moment the program reaches the call.

Total : Integer := 0;

for Index in 1 .. 4 loop
   Total := Total + Index;
end loop;

--  1 + 2 + 3 + 4 is 10, so this script exits 10.
quit (Total);
